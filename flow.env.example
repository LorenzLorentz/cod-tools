# tools/scripts/remote.sh 的配置。复制为【课程仓库根目录】的 flow.env 再改
# （flow.env 在课程仓库的 .gitignore 里，也不会同步到服务器）。
# 写成 ${VAR:-默认值} 的形式，命令行上的环境变量（例如 JOBS=8 make bit）仍然优先。

REMOTE_HOST=${REMOTE_HOST:-cluster39}                  # ~/.ssh/config 里的 Host
REMOTE_DIR=${REMOTE_DIR:-vivado-flow/$(basename "$REPO_ROOT")}  # 服务器上的工作目录（相对 $HOME），默认按课程仓库目录名区分
IMAGE=${IMAGE:-vivado-flow:2024.2}                     # 带 gcc + matplotlib 的镜像（make image 生成）
BASE_IMAGE=${BASE_IMAGE:-vivado:2024.2}                # 原始 Vivado 镜像
VIVADO_MAX_THREADS=${VIVADO_MAX_THREADS:-8}            # 单个 Vivado 进程的线程数（上限 32）
JOBS=${JOBS:-4}                                        # launch_runs 并行数
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn              # make image 用的 apt 源
